<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:onboarding="clr-namespace:FishingHub.Mobile.Views.Onboarding"
              xmlns:auth="clr-namespace:FishingHub.Mobile.Views.Auth"

       x:Class="FishingHub.Mobile.AppShell"
       Shell.FlyoutBehavior="Disabled">

    <ShellContent Route="landing"
                  ContentTemplate="{DataTemplate onboarding:LandingPage}" />
    <ShellContent
                  Route="auth-placeholder"
                  ContentTemplate="{DataTemplate auth:AuthPlaceholderPage}" />
</Shell>