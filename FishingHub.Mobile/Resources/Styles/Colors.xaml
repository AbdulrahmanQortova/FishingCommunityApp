<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Brand colors — consistent across both themes -->
    <Color x:Key="Primary">#1B6FA8</Color>
    <Color x:Key="PrimaryDark">#0D4A73</Color>
    <Color x:Key="Secondary">#2CA58D</Color>
    <Color x:Key="Accent">#F4A623</Color>

    <Color x:Key="Success">#2E7D32</Color>
    <Color x:Key="Warning">#ED6C02</Color>
    <Color x:Key="Danger">#C62828</Color>

    <!-- Light theme -->
    <Color x:Key="LightBackground">#FFFFFF</Color>
    <Color x:Key="LightSurface">#F5F7FA</Color>
    <Color x:Key="LightTextPrimary">#1A1A1A</Color>
    <Color x:Key="LightTextSecondary">#5C6670</Color>
    <Color x:Key="LightBorder">#E0E4E8</Color>

    <!-- Dark theme -->
    <Color x:Key="DarkBackground">#121417</Color>
    <Color x:Key="DarkSurface">#1E2126</Color>
    <Color x:Key="DarkTextPrimary">#F0F0F0</Color>
    <Color x:Key="DarkTextSecondary">#A0A8B0</Color>
    <Color x:Key="DarkBorder">#2E3238</Color>


    <Color x:Key="White">White</Color>
</ResourceDictionary>